<% layout("layouts/boilerplate") %>

<!-- ✅ SUCCESS POPUP -->
<% if (query && query.success === 'plan_added') { %>
  <div id="successToast"
       class="fixed top-20 right-6 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg z-50 animate-slide-in">
    ✅ Smart Study Plan Added to Google Calendar
  </div>

  <script>
    setTimeout(() => {
      const toast = document.getElementById("successToast");
      if (toast) toast.style.display = "none";
    }, 3000);
  </script>
<% } %>

<style>
@keyframes slideIn {
  from { transform: translateX(100%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}
.animate-slide-in {
  animation: slideIn 0.4s ease;
}
</style>

<h2 class="text-3xl font-semibold mb-8">
  📊 Study <span class="text-accent">Analytics</span>
</h2>

<!-- ========================= -->
<!-- Overview -->
<!-- ========================= -->
<div class="bg-soft/60 backdrop-blur border border-white/10 rounded-xl p-6 mb-6">
  <h3 class="text-xl font-medium mb-4">Overall Progress</h3>

  <p class="mb-3 text-muted">
    Total Topics: <strong class="text-white"><%= totalTopics %></strong>
  </p>

  <ul class="space-y-1 text-muted">
    <li>Started: <%= stageStats.started %></li>
    <li>Basics Clear: <%= stageStats.basics %></li>
    <li>Practiced: <%= stageStats.practice %></li>
    <li>Revised: <%= stageStats.revision %></li>
    <li>Exam Ready: <%= stageStats.ready %></li>
  </ul>
</div>

<!-- ========================= -->
<!-- Importance vs Readiness -->
<!-- ========================= -->
<div class="bg-soft/60 backdrop-blur border border-white/10 rounded-xl p-6 mb-6">
  <h3 class="text-xl font-medium mb-4">
    High-Importance Topics Status
  </h3>

  <p class="text-muted mb-1">
    Total V-IMP / VV-IMP Topics:
    <strong class="text-white"><%= importantTotal %></strong>
  </p>

  <p class="text-muted mb-1">
    Exam Ready:
    <strong class="text-green-400"><%= importantReady %></strong>
  </p>

  <p class="text-muted">
    Not Ready:
    <strong class="text-red-400"><%= importantNotReady %></strong>
  </p>
</div>

<!-- ========================= -->
<!-- Mock Paper Analytics -->
<!-- ========================= -->
<div class="bg-soft/60 backdrop-blur border border-white/10 rounded-xl p-6 mb-10">
  <h3 class="text-xl font-medium mb-4">Mock Paper Usage</h3>

  <p class="text-muted mb-1">
    Mock papers are generated based on high-importance topics.
  </p>

  <p class="text-muted">
    (Advanced scoring analytics can be added later.)
  </p>
</div>

<a
  href="/"
  class="inline-block text-sm text-muted hover:text-accent transition"
>
  ⬅ Back to Home
</a>