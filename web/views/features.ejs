<% layout("layouts/boilerplate") %>

<main class="min-h-screen py-28">

  <div class="max-w-6xl mx-auto px-6">

    <!-- Page Title -->
    <div class="text-center mb-24">
      <h1 class="text-5xl font-light text-white mb-6">
        Everything you need to
        <span class="text-indigo-300 font-medium">master your studies</span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto">
        Revizo integrates LLM-driven study tools into a unified academic workflow.
      </p>
    </div>

    <!-- FEATURES GRID -->
    <div class="grid md:grid-cols-2 gap-16">

      <!-- 🔥 Smart Notes (UPDATED + IMPORTANT) -->
      <div class="dashboard-card p-10">
        <h2 class="text-2xl text-white font-medium mb-4">
          📂 Smart Notes Management
        </h2>
        <p class="text-white/70 mb-6">
          Upload PDFs and automatically transform them into structured topics. 
          Access all your notes anytime through the centralized “My Notes” dashboard.
        </p>
        <a href="/login?redirect=/notes"
           class="inline-block px-6 py-3 bg-indigo-500 rounded-lg hover:bg-indigo-600 transition">
          Open My Notes →
        </a>
      </div>

      <!-- AI Chat -->
      <div class="dashboard-card p-10">
        <h2 class="text-2xl text-white font-medium mb-4">
          🤖 HelperBot (LLM Assistant)
        </h2>
        <p class="text-white/70 mb-6">
          Context-aware explanations derived from your uploaded notes.
        </p>
        <a href="/login?redirect=/helperbot"
           class="inline-block px-6 py-3 bg-indigo-500 rounded-lg hover:bg-indigo-600 transition">
          Try HelperBot →
        </a>
      </div>

      <!-- Study Planner -->
      <div class="dashboard-card p-10">
        <h2 class="text-2xl text-white font-medium mb-4">
          🗓 Smart Study Planner
        </h2>
        <p class="text-white/70 mb-6">
          Generate personalized schedules based on syllabus weightage and priorities.
        </p>
        <a href="/login?redirect=/study-planner"
           class="inline-block px-6 py-3 bg-indigo-500 rounded-lg hover:bg-indigo-600 transition">
          Create Planner →
        </a>
      </div>

      <!-- Importance Tagging -->
      <div class="dashboard-card p-10">
        <h2 class="text-2xl text-white font-medium mb-4">
          🎯 Importance Tagging
        </h2>
        <p class="text-white/70 mb-6">
          Automatically classify topics as IMP, M-IMP, and VV-IMP for focused revision.
        </p>
      </div>

      <!-- Audio Mode -->
      <div class="dashboard-card p-10">
        <h2 class="text-2xl text-white font-medium mb-4">
          🎧 Audio Learning Mode
        </h2>
        <p class="text-white/70 mb-6">
          Convert study content into audio for revision on the go.
        </p>
        <a href="/login?redirect=/helperbot"
           class="inline-block px-6 py-3 bg-indigo-500 rounded-lg hover:bg-indigo-600 transition">
          Start Listening →
        </a>
      </div>

      <!-- Mock Generator -->
      <div class="dashboard-card p-10">
        <h2 class="text-2xl text-white font-medium mb-4">
          📝 Mock Paper Generator
        </h2>
        <p class="text-white/70 mb-6">
          Generate exam-style mock papers instantly for practice.
        </p>
        <a href="/login?redirect=/mock-paper"
           class="inline-block px-6 py-3 bg-indigo-500 rounded-lg hover:bg-indigo-600 transition">
          Generate Mock →
        </a>
      </div>

      <!-- PYQs Manager -->
      <div class="dashboard-card p-10">
        <h2 class="text-2xl text-white font-medium mb-4">
          📂 PYQs Manager
        </h2>
        <p class="text-white/70 mb-6">
          Organize and filter previous year questions for targeted preparation.
        </p>
        <a href="/login?redirect=/pyqs"
           class="inline-block px-6 py-3 bg-indigo-500 rounded-lg hover:bg-indigo-600 transition">
          Explore PYQs →
        </a>
      </div>

      <!-- Analytics -->
      <div class="dashboard-card p-10">
        <h2 class="text-2xl text-white font-medium mb-4">
          📊 Study Analytics
        </h2>
        <p class="text-white/70 mb-6">
          Track your progress and optimize your study strategy.
        </p>
        <a href="/login?redirect=/analytics"
           class="inline-block px-6 py-3 bg-indigo-500 rounded-lg hover:bg-indigo-600 transition">
          View Analytics →
        </a>
      </div>

    </div>

  </div>

</main>