<% layout("layouts/boilerplate") %>

<div class="max-w-5xl mx-auto mt-10">

  <!-- Header -->
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-semibold text-white">
      📂 My Notes
    </h2>

    <!-- 🔥 NEW HISTORY BUTTON -->
    <a href="/topics/history/all"
       class="px-4 py-2 border border-white/10 rounded-md text-sm text-white
              hover:border-accent hover:text-accent transition">
      📜 History
    </a>
  </div>

  <!-- Notes List -->
  <div class="grid gap-4">

    <% notes.forEach(note => { %>

      <div class="bg-soft p-5 rounded-xl flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 border border-white/10">

        <!-- Left -->
        <div>
          <h3 class="text-white font-medium text-lg">
            <%= note.originalFileName || "Untitled Note" %>
          </h3>

          <p class="text-sm text-muted">
            Topic: <%= note.topicTag || "General" %>
          </p>
        </div>

        <!-- Actions -->
        <div class="flex flex-wrap gap-3">

          <!-- 🔥 OPEN TOPICS (IMPORTANT) -->
          <a href="/notes/<%= note._id %>/topics"
             class="px-4 py-2 bg-accent text-white rounded-md text-sm hover:shadow-glow transition">
            Open →
          </a>

          <% 
            const fileName = note.storedFilePath 
              ? note.storedFilePath.split(/[\\/]/).pop() 
              : null; 
          %>

          <!-- VIEW PDF -->
          <% if (fileName) { %>
            <a href="/uploads/<%= fileName %>"
               target="_blank"
               class="px-4 py-2 border border-white/10 rounded-md text-sm
                      hover:border-accent hover:text-accent transition">
              View PDF
            </a>
          <% } else { %>
            <span class="px-4 py-2 text-sm text-red-400">
              No PDF
            </span>
          <% } %>

        </div>

      </div>

    <% }) %>

  </div>

</div>