<% layout("layouts/boilerplate") %>

<!-- ===============================
     Page Header
=============================== -->
<div class="max-w-4xl mx-auto mb-8">
  <h2 class="text-2xl sm:text-3xl font-semibold mb-1">
    <%= topic.title %>
  </h2>
  <p class="text-muted">
    Topic details, importance tagging, summaries, and references
  </p>
</div>

<!-- ===============================
     Importance + Teacher Comments
=============================== -->
<div class="flex justify-center mb-10">
  <div class="w-full max-w-4xl grid grid-cols-1 md:grid-cols-2 gap-6">

    <!-- Importance -->
    <div class="bg-soft/60 border border-white/10 rounded-xl p-6">
      <h3 class="text-lg font-medium mb-3">⭐ Mark Importance</h3>

      <form action="/topics/<%= topic._id %>/importance" method="POST">
        <select name="importance"
          class="w-full bg-bg border border-white/10 rounded-md px-4 py-2 text-gray-200 mb-3">
          <option value="IMP" <%= topic.importance === "IMP" ? "selected" : "" %>>IMP</option>
          <option value="M-IMP" <%= topic.importance === "M-IMP" ? "selected" : "" %>>M-IMP</option>
          <option value="V-IMP" <%= topic.importance === "V-IMP" ? "selected" : "" %>>V-IMP</option>
          <option value="VV-IMP" <%= topic.importance === "VV-IMP" ? "selected" : "" %>>VV-IMP</option>
        </select>

        <button class="px-4 py-2 bg-accent text-white rounded-md text-sm">
          Save
        </button>
      </form>
    </div>

    <!-- Teacher Comments -->
    <div class="bg-soft/60 border border-white/10 rounded-xl p-6">
      <h3 class="text-lg font-medium mb-3">🧑‍🏫 Teacher Comments</h3>

      <form action="/topics/<%= topic._id %>/comments" method="POST">
        <textarea name="teacherComments" rows="5"
          class="w-full bg-bg border border-white/10 rounded-md px-4 py-2 text-gray-200 mb-3"><%= topic.teacherComments %></textarea>

        <button class="px-4 py-2 bg-accent text-white rounded-md text-sm">
          Save
        </button>
      </form>
    </div>

  </div>
</div>

<!-- ===============================
     Original Content
=============================== -->
<% if (topic.content) { %>
<div class="flex justify-center mb-10">
  <div class="w-full max-w-4xl bg-soft/60 border border-white/10 rounded-xl p-6">
    <h3 class="text-lg font-medium mb-3">📄 Original Content</h3>
    <p class="text-gray-200 whitespace-pre-line">
      <%= topic.content %>
    </p>
  </div>
</div>
<% } %>

<!-- ===============================
     PDF Viewer
=============================== -->
<% if (topic.pdfPath) { %>
<div class="flex justify-center mb-10">
  <div class="w-full max-w-4xl bg-soft/60 border border-white/10 rounded-xl p-6">
    <h3 class="text-lg font-medium mb-4">📎 Uploaded PDF</h3>

    <iframe 
      src="/uploads/<%= topic.pdfPath %>" 
      class="w-full h-[600px] rounded-xl border border-white/10">
    </iframe>
  </div>
</div>
<% } %>

<!-- ===============================
     AI SUMMARY
=============================== -->
<div class="flex justify-center mb-10">
  <div class="w-full max-w-4xl bg-soft/60 border border-white/10 rounded-xl p-6">

    <h3 class="text-lg font-medium mb-4">🧠 AI Summary</h3>

    <form action="/topics/<%= topic._id %>/summarize" method="POST"
      class="flex gap-4 mb-4 flex-wrap">

      <label>
        <input type="radio" name="studyMode" value="exam"
          <%= topic.summaryMode !== "daily" ? "checked" : "" %>> Exam
      </label>

      <label>
        <input type="radio" name="studyMode" value="daily"
          <%= topic.summaryMode === "daily" ? "checked" : "" %>> Daily
      </label>

      <button class="px-4 py-2 bg-accent text-white rounded-md text-sm">
        Generate
      </button>
    </form>

    <% if (topic.summary) { %>

      <pre class="text-sm text-gray-200 whitespace-pre-wrap">
<%= topic.summary %>
      </pre>

      <!-- 🔥 CLEAN EMAIL FORMAT -->
      <%
      const cleanSummary = topic.summary
        .replace(/\*\*/g, "")
        .replace(/\*/g, "•")
        .replace(/#/g, "")
        .replace(/`/g, "")
        .replace(/\n{3,}/g, "\n\n");
      %>

      <!-- ACTIONS -->
      <div class="mt-4 flex gap-3 flex-wrap">

        <a href="/topics/<%= topic._id %>/export"
          class="px-4 py-2 border border-white/10 rounded-md text-sm hover:border-accent hover:text-accent transition">
          📥 Export CSV
        </a>

        <a href="https://mail.google.com/mail/?view=cm
&to=<%= user.email %>
&su=<%= encodeURIComponent('Revizo Summary - ' + topic.title) %>
&body=<%= encodeURIComponent(
`📘 REVIZO SUMMARY

📝 Topic: ${topic.title}

━━━━━━━━━━━━━━━━━━━━

${cleanSummary}

━━━━━━━━━━━━━━━━━━━━

Generated using Revizo AI 🚀`
) %>"
          target="_blank"
          class="px-4 py-2 border border-white/10 rounded-md text-sm hover:border-accent hover:text-accent transition">
          📧 Share via Gmail
        </a>

      </div>

    <% } %>

  </div>
</div>

<!-- ===============================
     SUMMARY HISTORY
=============================== -->
<% if (topic.summaryHistory && topic.summaryHistory.length > 0) { %>
<div class="flex justify-center mb-10">
  <div class="w-full max-w-4xl bg-soft/60 border border-white/10 rounded-xl p-6">

    <h3 class="text-lg font-medium mb-4">📜 Summary History</h3>

    <% topic.summaryHistory.slice().reverse().forEach(item => { %>

      <div class="border border-white/10 rounded-md p-4 mb-3">

        <div class="flex justify-between text-xs text-gray-400 mb-2">
          <span>
            <%= item.mode === "openrouter-vision" ? "Vision AI" : item.mode %>
          </span>
          <span><%= new Date(item.createdAt).toLocaleString() %></span>
        </div>

        <p class="text-sm text-gray-300">
          <%= item.content %>
        </p>

      </div>

    <% }) %>

  </div>
</div>
<% } %>

<a href="/notes" class="text-sm text-muted hover:text-accent transition">
  ⬅ Back to Notes
</a>