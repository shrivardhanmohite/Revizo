<% layout("layouts/boilerplate") %>

<!-- ===============================
     Page Header
=============================== -->
<div class="max-w-4xl mx-auto mb-8">

  <h2 class="text-2xl sm:text-3xl font-semibold mb-2">
    📘 Topics Extracted
  </h2>

  <p class="text-muted">
    From file:
    <span class="text-white font-medium">
      <%= note ? note.originalFileName : "Unknown File" %>
    </span>
  </p>

</div>

<!-- ===============================
     Topics List
=============================== -->
<div class="flex justify-center mb-12">
  <div class="w-full max-w-4xl">

    <% if (!topics || topics.length === 0) { %>

      <!-- Empty State -->
      <div class="bg-soft/60 backdrop-blur border border-white/10 rounded-xl p-6 text-center text-muted">
        No topics found for this document.
      </div>

    <% } else { %>

      <div class="space-y-4">

        <% topics.forEach(topic => { %>

          <div class="bg-soft/60 backdrop-blur border border-white/10 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5 hover:border-accent/40 transition">

            <!-- Topic Info -->
            <div class="flex-1">
              <h3 class="font-medium text-white text-lg">
                <%= topic.title %>
              </h3>

              <p class="text-sm text-muted mt-1">
                Importance:
                <span class="text-gray-300 font-medium">
                  <%= topic.importance || "IMP" %>
                </span>
              </p>

              <% if (topic.pdfPath) { %>
                <p class="text-xs text-accent mt-1">
                  📎 Linked with PDF
                </p>
              <% } %>
            </div>

            <!-- Actions -->
            <div class="flex gap-3 flex-wrap">

              <!-- 🔥 PRIMARY ACTION -->
              <a
                href="/topics/<%= topic._id %>"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-indigo-500 text-white text-sm hover:bg-indigo-600 transition shadow-sm"
              >
                📖 Study
              </a>

              <!-- View PDF -->
              <% if (topic.pdfPath) { %>
                <a
                  href="/uploads/<%= topic.pdfPath %>"
                  target="_blank"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-md border border-white/10 text-sm hover:border-indigo-400 hover:text-indigo-400 transition"
                >
                  👁 View
                </a>

                <!-- Download -->
                <a
                  href="/uploads/<%= topic.pdfPath %>"
                  download
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-md border border-white/10 text-sm hover:border-green-400 hover:text-green-400 transition"
                >
                  ⬇ Download
                </a>
              <% } %>

            </div>

          </div>

        <% }) %>

      </div>

    <% } %>

    <!-- Back -->
    <div class="mt-10">
      <a href="/notes" class="text-sm text-muted hover:text-accent transition">
        ⬅ Back to Notes
      </a>
    </div>

  </div>
</div>